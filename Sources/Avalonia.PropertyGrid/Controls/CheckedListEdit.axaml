<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Avalonia.PropertyGrid.Controls">
    <Design.PreviewWith>
        <controls:CheckedListEdit />
    </Design.PreviewWith>

    <Style Selector="controls|CheckedListEdit">
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Border BorderBrush="Gray" BorderThickness="0.5" CornerRadius="0,0,5,5" Margin="0">
                        <ListBox ItemsSource="{Binding Model.Items, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="200">
							<ListBox.ItemTemplate>
                                <DataTemplate x:DataType="controls:CheckedListItemViewModel">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Margin="4,0,4,0" IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                            <TextBlock Margin="2,0,2,0" Text="{Binding Name}" VerticalAlignment="Center"></TextBlock>    
                                        </CheckBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>